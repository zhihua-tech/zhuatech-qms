{
  "slug": "qms",
  "title": "批次抽样判定与漏检数量核对",
  "fields": [
    {
      "key": "id",
      "label": "记录编号",
      "type": "ID"
    },
    {
      "key": "lotQty",
      "label": "批次数量",
      "type": "NUMBER",
      "scale": 0,
      "min": "1",
      "max": "1000000"
    },
    {
      "key": "sampleQty",
      "label": "实际抽样件数",
      "type": "NUMBER",
      "scale": 0,
      "min": "1",
      "max": "1000000"
    },
    {
      "key": "defective",
      "label": "不合格件数",
      "type": "NUMBER",
      "scale": 0,
      "min": "0",
      "max": "1000000"
    },
    {
      "key": "acceptNumber",
      "label": "方案接收数",
      "type": "NUMBER",
      "scale": 0,
      "min": "0",
      "max": "1000000"
    },
    {
      "key": "rejectNumber",
      "label": "方案拒收数",
      "type": "NUMBER",
      "scale": 0,
      "min": "1",
      "max": "1000000"
    },
    {
      "key": "samplingComplete",
      "label": "规定抽样已完整",
      "type": "ENUM",
      "options": [
        "YES",
        "NO"
      ]
    }
  ],
  "columns": [
    {
      "key": "sampledPct",
      "label": "抽样覆盖%"
    },
    {
      "key": "observedDefectPct",
      "label": "观察不合格率%"
    },
    {
      "key": "uninspectedQty",
      "label": "未抽查数量"
    }
  ],
  "description": "使用已批准抽样方案中的接收数和拒收数核对抽样结果，不自行生成AQL标准表或取代真实批次放行。",
